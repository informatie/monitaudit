# ---------------------------------------------------------------------------
# monitaudit.runtime
# Application-specific MonitAudit runtime configuration.
# default all sinks false meand NO output
# ---------------------------------------------------------------------------
monitaudit:
  application: myappl

  # -------------------------------------------------------------------------
  # GLOBAL APPLICATION SETTINGS
  # -------------------------------------------------------------------------

  global:
    sinks:
      console_sink:
        parameters:
          - cust_nummer
          - order_code
          - order_name
          - jan

  # -------------------------------------------------------------------------
  # ENVIRONMENT-SPECIFIC SETTINGS
  # -------------------------------------------------------------------------

  environments:

    # -----------------------------------------------------------------------
    # DEVELOPMENT
    # -----------------------------------------------------------------------

    dev:
      sinks:
        console_sink:
          enabled: true
        file_sink:
          path: output/file/monitaudit        
          enabled: true          
        json_sink:
          path: output/files/monitaudit        
          enabled: true          
        delta_sink:
          enabled: false              
          table: dev.monitaudit.monitaudit_logs

    # -----------------------------------------------------------------------
    # ACCEPTANCE
    # -----------------------------------------------------------------------

    acc:
      sinks:
        console_sink:
          enabled: false

        delta_sink:
          table: acc.monitaudit.monitaudit_logs

    # -----------------------------------------------------------------------
    # PRODUCTION
    # -----------------------------------------------------------------------

    prod:
      logging:
        level: WARNING

      sinks:
        console_sink:
          enabled: false

        json_sink:
          enabled: true
          path: /var/log/monitaudit/monitaudit.jsonl

        delta_sink:
          enabled: false
          table: prod.monitaudit.monitaudit_logs